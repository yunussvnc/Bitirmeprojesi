################################################################################
# backend/.env.production - Render.com Production Environment Variables
# Bu dosya GIT'e EKLENMEMELI! Sadece referans için.
# Gerçek değerler Render Dashboard'dan girilecek.
################################################################################

# ── Veritabanı (PostgreSQL - Render tarafından otomatik sağlanır) ────────────
# Render otomatik olarak DATABASE_URL'i PostgreSQL connection string'i ile set eder
# Örnek: postgresql://user:pass@hostname:5432/dbname
DATABASE_URL=${DATABASE_URL}

# ── JWT (Production için güçlü bir key oluşturun!) ────────────────────────────
# GÜVENLİK UYARISI: Aşağıdaki değeri KESİNLİKLE rastgele güçlü bir secret key ile değiştirin!
# Güvenli JWT key oluşturmak için terminalde şunu çalıştırın:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=BURAYA_GUCLU_BIR_SECRET_KEY_GIRIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=365

# ── CORS (Production'da spesifik origin'ler belirtin!) ────────────────────────
# GÜVENLİK UYARISI: Eğer web uygulamanız veya admin paneliniz varsa `*` kullanmayın!
# Web için virgülle ayrılmış origin'ler girin. Sadece mobil uygulama ise `*` kalabilir.
# Örnek: https://asemos.tr,https://admin.asemos.tr
ALLOWED_ORIGINS=*

# ── LLM — Groq API ────────────────────────────────────────────────────────────
LLM_ENABLED=True
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_BURAYA_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
RECOMMEND_CACHE_TTL=1800

# ── E-posta (SMTP / Gmail) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=BURAYA_GMAIL_ADRESI
SMTP_PASS=BURAYA_GMAIL_APP_PASSWORD

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=BURAYA_GOOGLE_MAPS_API_KEY

# ── Cloudinary (Görsel Yükleme) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=BURAYA_CLOUD_NAME
CLOUDINARY_API_KEY=BURAYA_API_KEY
CLOUDINARY_API_SECRET=BURAYA_API_SECRET
