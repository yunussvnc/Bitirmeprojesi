################################################################################
# backend/.env.example
# Bu dosyayı kopyalayıp .env olarak kaydet:
#   cp .env.example .env
#
# ⚠️  .env git'e commit edilmez (.gitignore'da)
# ✅  Geliştirme ortamı için bu değerleri kullanabilirsiniz
################################################################################

# ── Veritabanı ──────────────────────────────────────────────────────────────
# Host makineden Docker Postgres: docker-compose maps 5433:5432
DATABASE_URL=postgresql://postgres:123@localhost:5433/ai_mekan_oneri_db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
PLACES_SYNC_ON_STARTUP=false

# ── JWT ─────────────────────────────────────────────────────────────────────
# Production'da güçlü ve benzersiz değer kullanın; gerçek secret commit etmeyin.
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── LLM — Groq API ──────────────────────────────────────────────────────────
LLM_ENABLED=True
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RECOMMEND_CACHE_TTL=1800

# ── E-posta (SMTP / Gmail) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Geliştirme: SMTP yokken doğrulama mailini konsola yaz (prod'da false bırakın)
DEV_SKIP_EMAIL_VERIFICATION=true

# ── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── SerpAPI (mekan Google yorumları) ─────────────────────────────────────────
SERPAPI_KEY=

# ── Cloudinary Upload ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sosyal Giriş ────────────────────────────────────────────────────────────
# Google ID token audience değerleri. Birden fazla client için virgülle ayırın.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=

# Apple identity token audience değeri: iOS bundle id veya web/service id.
APPLE_CLIENT_ID=com.asemos.mobile
APPLE_ALLOWED_CLIENT_IDS=
