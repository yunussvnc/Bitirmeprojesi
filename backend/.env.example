# ── Veritabanı ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:123@localhost:5432/ai_mekan_oneri_db

# ── JWT — Ortak geliştirme key'i (ikisi de aynı key'i kullanmalı!) ──────────
# ❗ Production'da mutlaka değiştir: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=8ebd03507143f3f53aaa95260598d028a3ed6dfc52e6db408c607cdf4c67c167
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── LLM — Groq API ──────────────────────────────────────────────────────────
LLM_ENABLED=True
