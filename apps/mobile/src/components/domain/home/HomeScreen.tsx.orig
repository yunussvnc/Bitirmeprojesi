/**
 * Ana Sayfa – Keşfet + Ana Sayfa Birleşimi
 *
 * Arama, tercihler, filtreler ve AI önerisi tek ekranda.
 * UX/UI uyumlu, kompakt düzen.
 */

import { router, useNavigation } from "expo-router";
import React, { useState, useEffect, useMemo, useCallback, useRef } from "react";
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  Platform,
  RefreshControl,
  ViewToken,
  Animated,
  Easing,
  Keyboard,
  TouchableWithoutFeedback,
} from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import LottieView from "lottie-react-native";
import { FlashList, FlashListRef } from "@shopify/flash-list";
import * as Location from "expo-location";
import { useTheme } from "@/src/hooks/useTheme";
import { Screen, type ScreenRef } from "@/src/components/shared/layout";
import {
  ChatInput,
  AnimatedPlaceCard,
  ErrorState,
  EmptyState,
  PlaceCardSkeleton,
  FilterBottomSheet,
  getFilterSummaryChips,
  countActiveFilters,
  IconSymbol,
  type FilterValues,
} from "@/src/components/shared/ui";
import { usePreferences } from "@/src/store/preferences";
import { getPlaceImageSource, hasPlaceImage } from "@/src/utils/placeImages";
import { createTextStyle, s } from "@/src/constants/design";
import { getAllPlaces, getForYouPlaces, logInteraction } from "@/src/services/mekanService";
import { recommendPlaces } from "@/src/services/api";
import type { Place } from "@/src/services/mekanService";
import type { RecommendItem, RecommendResponse } from "@/src/types/recommend";
import { handleApiError } from "@/src/utils/errorHandler";
import { getCurrentLocation } from "@/src/utils/location";
import { lightImpact } from "@/src/utils/haptics";
import { useAppStore } from "@/src/store/useAppStore";
import { useTabBarVisibility } from "@/src/components/layout/TabBarVisibilityContext";
import { useTranslation } from "react-i18next";
import { CustomAlert as Alert } from '@/src/components/ui/CustomAlert';

/* ── İlçe algılama (prompt'ta il/ilçe var mı?) ── */
const DISTRICTS = [
  "adalar", "arnavutkoy", "atasehir", "avcilar", "bagcilar", "bahcelievler", "bakirkoy",
  "basaksehir", "bayrampasa", "besiktas", "beykoz", "beylikduzu", "beyoglu", "buyukcekmece",
  "catalca", "cekmekoy", "esenler", "esenyurt", "eyupsultan", "fatih", "gaziosmanpasa",
  "gungoren", "kadikoy", "kagithane", "kartal", "kucukcekmece", "maltepe", "pendik",
  "sancaktepe", "sariyer", "silivri", "sile", "sisli", "sultanbeyli", "sultangazi",
  "tuzla", "umraniye", "uskudar", "zeytinburnu", "istanbul",
];

function normalizeTr(text: string): string {
  if (!text) return "";
  return text
    .toLowerCase()
    .replace(/ç/g, "c").replace(/ğ/g, "g").replace(/ı/g, "i")
    .replace(/ö/g, "o").replace(/ş/g, "s").replace(/ü/g, "u")
    .replace(/â/g, "a").replace(/î/g, "i").replace(/û/g, "u");
}

/** Prompt metninde herhangi bir İstanbul ilçesi veya "istanbul" geçiyor mu? */
function queryContainsLocation(query: string): boolean {
  const norm = normalizeTr(query);
  return DISTRICTS.some((d) => norm.includes(d));
}

type DisplayMode = "browse" | "ai";

/** Stable separator to avoid re-renders in FlashList */
const ItemSeparator = () => <View style={{ height: 6 }} />;

/** Common shape for list items (RecommendItem | Place) */
type PlaceLike = { id: number | string; name?: string; category?: string; city?: string; photo_url?: string; description?: string; subtitle?: string; tags?: string[] };

/** Ayrı component – FlatList her query değişiminde header'ı remount etmez, klavye kapanmaz */
function HomeListHeader({
  query,
  setQuery,
  aiLoading,
  runRecommend,
  hasActiveFilters,
  activeFilterCount,
  summaryChips,
  summaryExtra,
  hasAnyFilter,
  isAiMode,
  aiSummary,
  setAiSummary,
  setFilterSheetOpen,
  clearAll,
  clearAiResults,
  savedCount,
  onSavedPress,
}: {
  query: string;
  setQuery: (q: string) => void;
  aiLoading: boolean;
  runRecommend: () => void;
  hasActiveFilters: boolean;
  activeFilterCount: number;
  summaryChips: string[];
  summaryExtra: number;
  hasAnyFilter: boolean;
  isAiMode: boolean;
  aiSummary: string;
  setAiSummary: (s: string) => void;
  setFilterSheetOpen: (v: boolean) => void;
  clearAll: () => void;
  clearAiResults: () => void;
  savedCount: number;
  onSavedPress: () => void;
}) {
  const { colors } = useTheme();
  const { t } = useTranslation();
  return (
      <View>
        <View style={styles.header}>
          <View style={styles.headerLeft}>
            <View style={styles.titleRow}>
              <Text style={[createTextStyle("title", colors.text.primary), styles.title]}>{t('home.title')}</Text>
            </View>
          </View>
          <View style={styles.headerRight}>
            {isAiMode && (
              <TouchableOpacity
                onPress={clearAiResults}
                style={[styles.clearAiBtn, { backgroundColor: colors.accent.primary + "15", borderColor: colors.accent.primary + "40" }]}
                activeOpacity={0.7}
              >
                <IconSymbol name="xmark" size={13} color={colors.accent.primary} />
                <Text style={[styles.clearAiBtnText, { color: colors.accent.primary }]}>{t('home.clear')}</Text>
              </TouchableOpacity>
            )}
            <TouchableOpacity
              onPress={onSavedPress}
              style={[styles.savedBtn, { backgroundColor: colors.surface.elevated }]}
              activeOpacity={0.7}
            >
              <IconSymbol name="bookmark.fill" size={22} color={colors.text.secondary} />
            </TouchableOpacity>
          </View>
        </View>

        <View style={styles.searchWrap}>
          <ChatInput
            value={query}
            onChangeText={setQuery}
            onSubmit={runRecommend}
            placeholder={t('home.search_placeholder')}
            loading={aiLoading}
            containerStyle={styles.chatInput}
          />
        </View>

        <View style={styles.filterSummaryRow}>
          <TouchableOpacity
            onPress={() => {
              lightImpact();
              setFilterSheetOpen(true);
            }}
            activeOpacity={0.7}
            style={[
              styles.filterTrigger,
              {
                backgroundColor: hasActiveFilters ? colors.accent.primary + "12" : colors.background.tertiary,
                borderColor: hasActiveFilters ? colors.accent.primary + "30" : colors.surface.border,
              },
            ]}
          >
            <IconSymbol
              name="slider.horizontal.3"
              size={15}
              color={hasActiveFilters ? colors.accent.primary : colors.text.tertiary}
            />
            <Text style={[styles.filterTriggerText, { color: hasActiveFilters ? colors.accent.primary : colors.text.secondary }]}>
              {activeFilterCount > 0 ? t('home.filters_count', { count: activeFilterCount }) : t('home.filters')}
            </Text>
          </TouchableOpacity>

          {summaryChips.map((chip) => (
            <View key={chip} style={[styles.summaryTag, { backgroundColor: colors.background.tertiary }]}>
              <Text style={[styles.summaryTagText, { color: colors.text.secondary }]}>{chip}</Text>
            </View>
          ))}
          {summaryExtra > 0 && (
            <View style={[styles.summaryTag, { backgroundColor: colors.background.tertiary }]}>
              <Text style={[styles.summaryTagText, { color: colors.text.tertiary }]}>+{summaryExtra}</Text>
            </View>
          )}
          {hasAnyFilter && (
            <TouchableOpacity onPress={clearAll} hitSlop={8} activeOpacity={0.7}>
              <IconSymbol name="xmark.circle.fill" size={18} color={colors.text.tertiary} />
            </TouchableOpacity>
          )}
        </View>

        {isAiMode && aiSummary ? (
          <View
            style={[
              styles.summaryBanner,
              { backgroundColor: colors.accent.primary + "10", borderColor: colors.accent.primary + "25" },
            ]}
          >
            <View style={styles.summaryBannerIcon}>
              <IconSymbol name="sparkles" size={14} color={colors.accent.primary} />
            </View>
            <Text style={[styles.summaryBannerText, { color: colors.text.secondary }]} numberOfLines={3}>
              {aiSummary}
            </Text>
            <TouchableOpacity onPress={() => setAiSummary("")} hitSlop={8}>
              <IconSymbol name="xmark" size={14} color={colors.text.tertiary} />
            </TouchableOpacity>
          </View>
        ) : null}

        {aiLoading && (
          <View style={[styles.aiLoadingWrap, { backgroundColor: colors.surface.elevated }]}>
            <IconSymbol name="sparkles" size={16} color={colors.accent.primary} />
            <Text style={[styles.aiLoadingText, { color: colors.text.secondary }]}>{t('home.ai_thinking')}</Text>
          </View>
        )}
      </View>
  );
}

export default function HomeScreen() {
  const { colors } = useTheme();
  const { t } = useTranslation();
  const navigation = useNavigation();
  const screenRef = useRef<ScreenRef>(null);
  const flatListRef = useRef<FlashListRef<any>>(null);
  const { prefs, patchPrefs, resetPrefs } = usePreferences();
  const savedIds = useAppStore((s) => s.savedIds);

  const [query, setQuery] = useState("");
  const [allPlaces, setAllPlaces] = useState<Place[]>([]);
  const [loading, setLoading] = useState(true);
  const [aiLoading, setAiLoading] = useState(false);
  const [error, setError] = useState("");
  const [aiItems, setAiItems] = useState<RecommendItem[]>([]);
  const [aiSummary, setAiSummary] = useState("");
  const [displayMode, setDisplayMode] = useState<DisplayMode>("browse");
  const [refreshing, setRefreshing] = useState(false);
  const [placesById, setPlacesById] = useState<Record<string, Place>>({});
  const [filterSheetOpen, setFilterSheetOpen] = useState(false);
  const [userLocation, setUserLocation] = useState<{ lat: number; lng: number } | null>(null);
  const [miniBarVisible, setMiniBarVisible] = useState(false);
  const miniBarAnim = useRef(new Animated.Value(0)).current;
  const lastScrollY = useRef(0);
  const lastToggleY = useRef(0);
  const lastDirection = useRef<"up" | "down" | null>(null);
  const miniBarVisibleRef = useRef(false);
  const { hide: hideTabBar, show: showTabBar, fadeOut, fadeIn } = useTabBarVisibility();
  const insets = useSafeAreaInsets();
  const [filters, setFilters] = useState<FilterValues>({
    province: null,
    district: null,
  });

  useEffect(() => {
    const unsub = navigation.addListener("tabPress" as any, () => {
      screenRef.current?.scrollToTop?.();
      flatListRef.current?.scrollToOffset?.({ offset: 0, animated: true });
    });
    return unsub;
  }, [navigation]);

  useEffect(() => {
    loadPlaces();
    requestLocation();
  }, []);

  const requestLocation = async () => {
    try {
      const { status } = await Location.requestForegroundPermissionsAsync();
      if (status !== "granted") return;
      let loc = await Location.getLastKnownPositionAsync();
      if (!loc) {
        loc = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced });
      }
      if (loc) {
        setUserLocation({ lat: loc.coords.latitude, lng: loc.coords.longitude });
      }
    } catch {
      // Fallback: İstanbul merkez
    }
  };

  useEffect(() => {
    if (allPlaces.length > 0) {
      const map: Record<string, Place> = {};
      allPlaces.forEach((p) => {
        map[String(p.id)] = p;
      });
      setPlacesById(map);
    }
  }, [allPlaces]);

  const loadPlaces = async () => {
    try {
      setLoading(true);
      setError("");
      
      const loc = await getCurrentLocation().catch(() => null);
      let lat, lng;
      if (loc) {
        lat = loc.latitude;
        lng = loc.longitude;
      }
      
      const paginatedData = await getForYouPlaces(lat, lng, 1, 12);
      setAllPlaces(paginatedData.items);
    } catch (e: unknown) {
      const appError = handleApiError(e);
      setError(appError.userMessage);
      setAllPlaces([]);
    } finally {
      setLoading(false);
    }
  };

  const runRecommend = useCallback(async () => {
    const trimmedQuery = query.trim();

    // Konum kontrolü: filtreden ilçe seçili mi VEYA prompt'ta ilçe/il geçiyor mu?
    const hasFilterDistrict = Boolean(filters.district);
    const hasQueryLocation = trimmedQuery ? queryContainsLocation(trimmedQuery) : false;

    if (!hasFilterDistrict && !hasQueryLocation) {
      Alert.alert(
        "Konum Gerekli",
        "Lütfen filtreden il ve ilçe seçiniz veya arama metnine bir ilçe adı yazınız (örn: Kadıköy'de kafe, Beşiktaş'ta bar).",
        [
          { text: "Filtre Aç", onPress: () => setFilterSheetOpen(true) },
          { text: "Tamam", style: "cancel" },
        ],
      );
      return;
    }

    try {
      setAiLoading(true);
      setError("");
      setAiSummary("");
      const res: RecommendResponse = await recommendPlaces({
        queryText: trimmedQuery || undefined,
        preferences: {
          vibe: prefs.vibe || undefined,
          purpose: prefs.purpose || undefined,
          budget: prefs.budget || undefined,
        },
        location: userLocation || undefined,
        radius_m: 5000,
        district: filters.district || undefined,
      });
      setAiItems(res.items ?? []);
      setAiSummary(res.summary || "");
      setDisplayMode("ai");
    } catch (e: unknown) {
      const err = handleApiError(e).userMessage;
      setError(err);
    } finally {
      setAiLoading(false);
    }
  }, [query, prefs, filters, userLocation]);

  const animateMiniBar = useCallback(
    (visible: boolean) => {
      if (miniBarVisibleRef.current === visible) return;
      miniBarVisibleRef.current = visible;
      setMiniBarVisible(visible);
      if (visible) hideTabBar();
      else showTabBar();
      Animated.timing(miniBarAnim, {
        toValue: visible ? 1 : 0,
        duration: 180,
        easing: Easing.out(Easing.cubic),
        useNativeDriver: true,
      }).start();
    },
    [miniBarAnim, hideTabBar, showTabBar]
  );

  const handleScroll = useCallback(
    (rawY: number) => {
      const y = Math.max(rawY, 0);
      const dy = y - lastScrollY.current;
      lastScrollY.current = y;

      if (y <= 0) {
        animateMiniBar(false);
        lastToggleY.current = 0;
        lastDirection.current = null;
        return;
      }

      if (dy === 0) return;

      const direction: "up" | "down" = dy > 0 ? "down" : "up";
      if (direction !== lastDirection.current) {
        lastDirection.current = direction;
        lastToggleY.current = y;
      }

      if (direction === "down") {
        if (miniBarVisibleRef.current) animateMiniBar(false);
        fadeOut();
      } else {
        fadeIn();
        if (!miniBarVisibleRef.current && y > 120 && lastToggleY.current - y >= 20) {
          animateMiniBar(true);
          lastToggleY.current = y;
        }
      }
    },
    [animateMiniBar]
  );

  const miniBarOpacity = miniBarAnim.interpolate({ inputRange: [0, 1], outputRange: [0, 1] });
  const miniBarTranslateY = miniBarAnim.interpolate({ inputRange: [0, 1], outputRange: [-48, 0] });

  const handleRefresh = async () => {
    setRefreshing(true);
    lightImpact();
    await loadPlaces();
    setRefreshing(false);
  };

  const activeFilterCount = countActiveFilters(filters);
  const hasActiveFilters = activeFilterCount > 0;

  const filteredPlaces = useMemo(() => {
    let list = [...allPlaces];
    if (filters.district) {
      const locNorm = filters.district.toLowerCase();
      list = list.filter((p) => {
        const name = (p.name ?? "").toLowerCase();
        const addr = (p.address ?? "").toLowerCase();
        return name.includes(locNorm) || addr.includes(locNorm);
      });
    }
    return list.slice(0, 12);
  }, [allPlaces, filters.district]);

  const displayList = displayMode === "ai" ? aiItems : filteredPlaces;
  const isAiMode = displayMode === "ai";

  const handleApplyFilters = useCallback(
    (v: FilterValues) => {
      setFilters(v);
    },
    []
  );

  const clearAll = useCallback(() => {
    lightImpact();
    resetPrefs();
    setFilters({ province: null, district: null });
    setQuery("");
    setAiItems([]);
    setAiSummary("");
    setDisplayMode("browse");
  }, [resetPrefs]);

  const clearAiResults = useCallback(() => {
    lightImpact();
    setQuery("");
    setAiItems([]);
    setAiSummary("");
    setDisplayMode("browse");
  }, []);

  const getLocationFromName = (name: string) => (name?.includes(" - ") ? name.split(" - ")[1]?.trim() : undefined);

  const navigatingRef = useRef(false);
  const handlePlacePress = useCallback((id: string, name?: string, category?: string, photo_url?: string, subtitle?: string, description?: string, address?: string) => {
    if (navigatingRef.current) return;
    navigatingRef.current = true;
    lightImpact();
    router.push({
      pathname: "/place/[id]",
      params: {
        id,
        name: name || "",
        category: category || "",
        photo_url: photo_url || "",
        subtitle: subtitle || "",
        description: description || "",
        address: address || "",
      }
    } as any);
    setTimeout(() => {
      navigatingRef.current = false;
    }, 1000);
  }, []);

  const renderPlaceItem = useCallback(
    ({ item, index }: { item: RecommendItem | Place; index: number }) => {
      const it = item as PlaceLike;
      const id = String(it.id);
      const place = placesById[id] || (item as Place);
      const merged = {
        id,
        name: it.name,
        category: it.category ?? place?.category,
        photo_url: it.photo_url ?? place?.photo_url,
        description: it.description ?? place?.description,
        subtitle: it.subtitle ?? place?.subtitle,
      };
      const loc = getLocationFromName(it.name ?? "");
      const isAi = displayMode === "ai";

      return (
        <AnimatedPlaceCard
          key={id}
          index={index}
          placeId={id}
          image={getPlaceImageSource(merged)}
          imagePlaceholder={!hasPlaceImage(merged)}
          title={it.name ?? t('common.venue')}
          subtitle={it.subtitle ?? place?.subtitle}
          tags={it.tags ?? place?.tags}
          category={it.category ?? place?.category}
          location={loc}
          address={(place as any)?.address}
          city={it.city ?? (place as any)?.city}
          explanation={isAi ? (item as RecommendItem).explanation : undefined}
          distance_m={isAi ? (item as RecommendItem).distance_m : undefined}
          isRecommended={isAi}
          hasMenu={!!(place?.menu_items && place.menu_items.length > 0)}
          onPress={() => handlePlacePress(
            id,
            it.name ?? t('common.venue'),
            it.category ?? place?.category,
            it.photo_url ?? place?.photo_url,
            it.subtitle ?? place?.subtitle,
            it.description ?? place?.description,
            (place as any)?.address
          )}
        />
      );
    },
    [placesById, handlePlacePress, displayMode]
  );

  const listEmpty = useCallback(() => {
    if (loading && allPlaces.length === 0) {
      return (
        <View style={styles.skeletonWrap}>
          <PlaceCardSkeleton count={4} />
        </View>
      );
    }
    if (error && !aiLoading) {
      return (
        <View style={styles.centerWrap}>
          <ErrorState title={t('home.error_title')} description={error} onRetry={loadPlaces} />
        </View>
      );
    }
    if (isAiMode && !aiLoading && aiItems.length === 0) {
      return (
        <View style={styles.centerWrap}>
          <EmptyState
            variant="search"
            title={t('home.no_results')}
            description={t('home.no_results_desc')}
            actionLabel={t('home.clear')}
            onAction={clearAll}
          />
        </View>
      );
    }
    if (!isAiMode && filteredPlaces.length === 0) {
      return (
        <View style={styles.centerWrap}>
          <EmptyState
            variant={hasActiveFilters ? "search" : "places"}
            title={hasActiveFilters ? t('home.no_results') : t('home.no_places')}
            description={hasActiveFilters ? t('home.change_filters') : t('home.no_places_desc')}
            actionLabel={hasActiveFilters ? t('home.clear') : undefined}
            onAction={hasActiveFilters ? clearAll : undefined}
          />
        </View>
      );
    }
    return null;
  }, [
    loading,
    allPlaces.length,
    error,
    aiLoading,
    isAiMode,
    aiItems.length,
    filteredPlaces.length,
    hasActiveFilters,
    clearAll,
  ]);

  const hasAnyFilter = hasActiveFilters || query.trim();
  const { chips: summaryChips, extra: summaryExtra } = getFilterSummaryChips(filters, 3);

  return (
    <Screen ref={screenRef} scrollable={false} onRefresh={handleRefresh} refreshing={refreshing} withTabBar>
      <View style={styles.screen}>
        <View style={{ position: 'absolute', top: 60, left: 0, right: 0, alignItems: 'center', zIndex: -1 }}>
          <LottieView
            source={require('@/assets/animations/loading.json')}
            autoPlay={refreshing}
            loop={refreshing}
            style={{ width: 80, height: 80 }}
          />
        </View>
        <FilterBottomSheet
          visible={filterSheetOpen}
          onClose={() => setFilterSheetOpen(false)}
          values={filters}
          onApply={handleApplyFilters}
        />

        <FlashList
          ref={flatListRef}
          data={displayList}
          keyExtractor={(item) => String((item as PlaceLike).id)}
          renderItem={renderPlaceItem}
          ListHeaderComponent={
            <HomeListHeader
              query={query}
              setQuery={setQuery}
              aiLoading={aiLoading}
              runRecommend={runRecommend}
              hasActiveFilters={hasActiveFilters}
              activeFilterCount={activeFilterCount}
              summaryChips={summaryChips}
              summaryExtra={summaryExtra}
              hasAnyFilter={!!hasAnyFilter}
              isAiMode={isAiMode}
              aiSummary={aiSummary}
              setAiSummary={setAiSummary}
              setFilterSheetOpen={setFilterSheetOpen}
              clearAll={clearAll}
              clearAiResults={clearAiResults}
              savedCount={savedIds.length}
              onSavedPress={() => {
                lightImpact();
                router.push("/saved" as any);
              }}
            />
          }
          ListEmptyComponent={listEmpty}
          ItemSeparatorComponent={ItemSeparator}
          estimatedItemSize={CARD_HEIGHT}
          overrideItemLayout={(layout, item, index) => {
            layout.size = CARD_HEIGHT;
          }}
          contentContainerStyle={displayList.length > 0 ? styles.listContent : styles.listContentEmpty}
          refreshControl={
            <RefreshControl 
              refreshing={refreshing} 
              onRefresh={handleRefresh} 
              tintColor="transparent" 
              colors={['transparent']}
              progressBackgroundColor="transparent"
            />
          }
          showsVerticalScrollIndicator={false}
          keyboardDismissMode="on-drag"
          keyboardShouldPersistTaps="handled"
          onScroll={(e) => handleScroll(e.nativeEvent.contentOffset.y)}
          scrollEventThrottle={32}
        />
        <Animated.View
          style={[
            styles.miniBar,
            {
              backgroundColor: colors.background.primary,
              borderBottomColor: colors.surface.border,
              top: 0,
              opacity: miniBarOpacity,
              transform: [{ translateY: miniBarTranslateY }],
            },
          ]}
          pointerEvents={miniBarVisible ? "auto" : "none"}
        >
          <View style={styles.miniBarPlaceholder} />
          <Text style={[styles.miniTitle, { color: colors.text.primary }]}>{t('home.title')}</Text>
          <TouchableOpacity
            style={[styles.miniIconBtn, { backgroundColor: colors.surface.default }]}
            onPress={() => {
              lightImpact();
              router.push("/saved" as any);
            }}
          >
            <IconSymbol name="bookmark.fill" size={18} color={colors.text.primary} />
          </TouchableOpacity>
        </Animated.View>
      </View>
    </Screen>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1 },
  header: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    marginBottom: s(4),
    overflow: "visible",
  },
  headerLeft: { flex: 1 },
  headerRight: {
    flexDirection: "row",
    alignItems: "center",
    gap: 10,
  },
  clearAiBtn: {
    flexDirection: "row",
    alignItems: "center",
    gap: 5,
    paddingHorizontal: 12,
    paddingVertical: 7,
    borderRadius: 20,
    borderWidth: 1,
  },
