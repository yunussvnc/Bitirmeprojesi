# API Configuration
# Copy to .env.local and override as needed.
# EXPO_PUBLIC_* vars are available at build time (EAS Build uses eas.json env).

# Development: API host when expoHost unavailable (e.g. physical device)
# EXPO_PUBLIC_DEV_API_HOST=192.168.1.9:8000

# Staging/Production: Full API URL override
# EXPO_PUBLIC_API_URL=https://api.staging.asemos.tr
