# API Configuration
# Copy to .env.local and override as needed.
# EXPO_PUBLIC_* vars are available at build time (EAS Build uses eas.json env).

# Development: LAN IP when Expo hostUri unavailable (physical device). Default: localhost:8000
# EXPO_PUBLIC_DEV_API_HOST=192.168.1.100:8000

# Staging/Production: Full API URL override
# EXPO_PUBLIC_API_URL=https://api.staging.asemos.com

# Social login (Google / Apple) - use EAS Secrets or eas.json env; do not commit real IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Keşfet haritası — Google Maps JavaScript API (Maps SDK). Tanımlı değilse Leaflet/OSM kullanılır.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
