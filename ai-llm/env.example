# Qdrant Vector Database
# Production'da kalıcı RAG için Qdrant Cloud URL girin.
# Boş bırakılırsa servis demo fallback olarak in-memory Qdrant kullanır ve restart sonrası
# ilk RAG isteğinde data/loaded_places.json dosyasını yeniden indeksler.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mekan_embeddings

# SerpApi - Google Maps Data
SERPAPI_KEY=your_serpapi_key_here
# Get free API key at: https://serpapi.com/manage-api-key
# Free: 100 searches/month
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# LLM Configuration
LLM_PROVIDER=layered
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Gemma 2 Model Seçenekleri
HUGGINGFACE_MODEL=google/gemma-2-2b-it
# google/gemma-2-2b-it  - 2B model, hızlı, düşük bellek (~5GB RAM)
# google/gemma-2-9b-it  - 9B model, daha kaliteli, yüksek bellek (~18GB RAM)
#
# Diğer Alternatifler:
# Qwen/Qwen2-1.5B-Instruct - Türkçe desteği iyi (~3GB)
# microsoft/Phi-3-mini-4k-instruct - İyi performans (~7GB)

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# RAG Settings
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.4
RAG_DATA_PATH=data/loaded_places.json
RAG_AUTO_INDEX=true
# false: cold start hızlı, ilk RAG isteği index yükler. true: startup'ta yükler.
RAG_INDEX_ON_STARTUP=false
RAG_FORCE_REINDEX=false
# false: /api/rag-search LLM secret olmadan deterministik analiz döner.
RAG_USE_LLM_GENERATOR=false

# Postgres sync: loaded_places.json -> places tablosu (Render startup'ta DB gerideyse upsert)
PLACES_SYNC_ON_STARTUP=false
PLACES_SYNC_MIN_RATIO=0.95

# Backend API
BACKEND_API_URL=http://localhost:8000

# PostgreSQL (Doğrudan DB bağlantısı)
# Ngrok gibi uzak tünel kullanıyorsanız host/port burada olmalı.
# Gerekirse sonuna `?sslmode=disable` ekleyebilirsiniz (sunucu ayarına bağlı).
# Host makineden Docker Postgres: docker-compose maps 5433:5432
DATABASE_URL=postgresql://postgres:123@localhost:5433/ai_mekan_oneri_db

# Redis Cache
# Production'da Upstash/Redis URL girilebilir; boşsa servis cache olmadan çalışır.
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8081

