# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mekan_embeddings

# LLM Configuration
# openai veya huggingface (local) seçin
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Local Model (HuggingFace) - LLM_PROVIDER=huggingface kullanırken
# Küçük modeller (önerilen):
# - Qwen/Qwen2-1.5B-Instruct (Türkçe desteği iyi, ~3GB)
# - TinyLlama/TinyLlama-1.1B-Chat-v1.0 (Çok küçük, ~2GB, İngilizce ağırlıklı)
# - microsoft/Phi-3-mini-4k-instruct (İyi performans, ~7GB)
# Fine-tuned model kullanmak için:
# HUGGINGFACE_MODEL=./models/fine_tuned
HUGGINGFACE_MODEL=Qwen/Qwen2-1.5B-Instruct

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# RAG Settings
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Backend API
BACKEND_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8081

