################################################################################
# AsEmOs Platform — Ortam Değişkenleri Şablonu
#
# Bu dosya yalnızca örnek değerler içerir. Gerçek anahtarları Git'e eklemeyin.
# Yerel backend için öncelikle backend/.env.example dosyasını kullanın.
################################################################################

# ── Yerel Backend / Docker Compose ────────────────────────────────────────────
# docker-compose.yml host üzerinde PostgreSQL'i 5433 portuna açar.
DATABASE_URL=postgresql://postgres:123@localhost:5433/ai_mekan_oneri_db
REDIS_URL=redis://localhost:6379/0

# ── docker-compose.prod.yml ───────────────────────────────────────────────────
# Production kullanmadan önce tüm CHANGE_ME değerlerini benzersiz secret'larla
# değiştirin. Bu değerler örnektir ve gerçek ortamda kullanılmamalıdır.
POSTGRES_USER=asemos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=asemos_db
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
QDRANT_API_KEY=CHANGE_ME_STRONG_API_KEY

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── E-posta ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEV_SKIP_EMAIL_VERIFICATION=true

# ── Harici Servisler ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
SERPAPI_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
