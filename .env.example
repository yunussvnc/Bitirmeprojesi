################################################################################
# AsEmOs Platform — Ortam Değişkenleri
# Kopyala: cp .env.example .env  (ya da her servis kendi .env.example'ını kullanır)
#
# backend/.env.example   → Backend için tam ayarlar
# ai-llm/.env            → AI servisi için ayarlar
################################################################################

# ── Backend Veritabanı ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:123@localhost:5432/ai_mekan_oneri_db

# ── JWT ─────────────────────────────────────────────────────────────────────
# Production'da güçlü ve benzersiz değer kullanın; gerçek secret commit etmeyin.
JWT_SECRET_KEY=change-me-in-local-env

# ── Groq API (LLM) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── SerpAPI (mekan arama — AI servisi için) ──────────────────────────────────
SERPAPI_KEY=

# ── E-posta (SMTP / Gmail) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Sosyal Giriş ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_CLIENT_ID=com.asemos.mobile
APPLE_ALLOWED_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
