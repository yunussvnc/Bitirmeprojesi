################################################################################
# AsEmOs Platform — Ortam Değişkenleri
# Kopyala: cp .env.example .env  (ya da her servis kendi .env.example'ını kullanır)
#
# backend/.env.example   → Backend için tam ayarlar
# ai-llm/.env            → AI servisi için ayarlar
################################################################################

# ── Backend Veritabanı (yerel/dev, docker-compose.prod.yml'de kullanılmıyor) ──
DATABASE_URL=postgresql://postgres:123@localhost:5432/ai_mekan_oneri_db

# ── docker-compose.prod.yml — Postgres/Redis/Qdrant kimlik bilgileri ────────
# Bu 5 değişken SADECE prod compose tarafından okunur (postgres/redis/qdrant
# servisleri + backend/migrate/ai-llm'in DATABASE_URL/REDIS_URL/QDRANT_URL
# derlemesi). Prod'a geçmeden önce placeholder'ları GERÇEK, güçlü değerlerle
# değiştirin — bunlar burada örnek/varsayılan DEĞİL, gerçek prod secret'ları.
POSTGRES_USER=asemos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=asemos_db
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
QDRANT_API_KEY=CHANGE_ME_STRONG_API_KEY

# ── JWT — Geliştirme ortamı için ortak key ───────────────────────────────────
# ❗ ÖNEMLI: İki kişi aynı anahtar kullanmalı, yoksa tokenlar birbirini doğrulamaz
# ❗ Production'da değiştir: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=8ebd03507143f3f53aaa95260598d028a3ed6dfc52e6db408c607cdf4c67c167

# ── Groq API (LLM — ücretsiz kota) ──────────────────────────────────────────
